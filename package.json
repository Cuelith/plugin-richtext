{
  "name": "plugin-richtext",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.8.1",
  "description": "Plugin Formattazione di Cuelith: dimensione, grassetto, corsivo e colore di singole parole, negli editor dei plugin.",
  "scripts": {
    "build": "vite build && node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@cuelith/panel": "link:../cuelith-sdk/packages/panel",
    "@cuelith/protocol": "link:../cuelith-sdk/packages/protocol"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
